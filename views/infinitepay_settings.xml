<odoo>
  <record id="view_infinitepay_config" model="ir.ui.view">
    <field name="name">infinitepay.config.settings</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <!-- 1: tenta localizar containers modernos -->
      <xpath expr="//div[contains(@class,'o_settings_container')]" position="inside">
        <div class="row mt16 o_setting_box">
          <div class="col-12 col-lg-6">
            <field name="infinitepay_handle"/>
          </div>
        </div>
      </xpath>

      <!-- 2: fallback para estruturas alternativas -->
      <xpath expr="//div[contains(@class,'o_setting_box')]" position="inside" attempt="true">
        <div class="row mt16 o_setting_box">
          <div class="col-12 col-lg-6">
            <field name="infinitepay_handle"/>
          </div>
        </div>
      </xpath>

      <!-- 3: fallback adicional para layouts antigos -->
      <xpath expr="//group" position="inside" attempt="true">
        <field name="infinitepay_handle"/>
      </xpath>
    </field>
  </record>
</odoo>
