<!-- plan_provisioning/views/plan_template_views.xml -->
<odoo>
  <record id="view_saas_plan_template_form" model="ir.ui.view">
    <field name="name">saas.plan.template.form</field>
    <field name="model">saas.plan.template</field>
    <field name="arch" type="xml">
      <form string="Template de Plano">
        <sheet>
          <group>
            <field name="name"/>
            <field name="plan_id"/>
          </group>
          <group string="Módulos">
            <field name="module_names" nolabel="1"/>
          </group>
          <group>
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_saas_plan_template_tree" model="ir.ui.view">
    <field name="name">saas.plan.template.tree</field>
    <field name="model">saas.plan.template</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="plan_id"/>
      </tree>
    </field>
  </record>

  <record id="action_saas_plan_template" model="ir.actions.act_window">
    <field name="name">Templates de Plano</field>
    <field name="res_model">saas.plan.template</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_saas_root" name="SaaS" sequence="10"/>
  <menuitem id="menu_saas_templates" name="Templates de Plano" parent="menu_saas_root" action="action_saas_plan_template" sequence="20"/>
</odoo>
