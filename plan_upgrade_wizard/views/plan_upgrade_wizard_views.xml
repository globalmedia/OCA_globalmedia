<!-- plan_upgrade_wizard/views/plan_upgrade_wizard_views.xml -->
<odoo>
  <record id="view_plan_upgrade_wizard_form" model="ir.ui.view">
    <field name="name">plan.upgrade.wizard.form</field>
    <field name="model">plan.upgrade.wizard</field>
    <field name="arch" type="xml">
      <form string="Trocar Plano">
        <sheet>
          <group>
            <field name="contract_id"/>
            <field name="new_plan_id"/>
            <field name="pro_rata_amount" readonly="1"/>
          </group>
        </sheet>
        <footer>
          <button string="Confirmar" type="object" name="action_confirm" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_plan_upgrade_wizard" model="ir.actions.act_window">
    <field name="name">Trocar Plano</field>
    <field name="res_model">plan.upgrade.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Menu opcional para testes; em produção, acione via botão em contrato -->
  <menuitem id="menu_saas_root" name="SaaS" sequence="10"/>
  <menuitem id="menu_plan_upgrade" name="Trocar Plano" parent="menu_saas_root" action="action_plan_upgrade_wizard" sequence="40"/>
</odoo>
